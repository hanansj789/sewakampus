APP_NAME=SewaKampus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sewakampus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

KEYCLOAK_SERVER_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=sewakampus
KEYCLOAK_CLIENT_ID=sewakampus-local
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:8000/auth/keycloak/callback

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sewakampus.test"
MAIL_FROM_NAME="${APP_NAME}"
